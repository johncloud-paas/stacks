# Secret used to sign and verify the JWTs issued by the backend (openssl rand -hex 32)
JWT_SECRET=
# SMTP host configuration for sending e-mails
SMTP_HOST=
# SMTP port for sending e-mails
SMTP_PORT=587
# SMTP username for sending e-mails
SMTP_USERNAME=
# SMTP password for sending e-mails
SMTP_PASSWORD=
# SMTP from address for sending e-mails
SMTP_FROM="Douceville <no-reply@domain.tld>"
# API key for OpenRouteService
OPENROUTESERVICE_KEY=
# Database (PostGIS)
POSTGRES_PASSWORD=
# URL de l'émetteur OIDC. Vide : connexion OIDC désactivée
OIDC_ISSUER_URL=
# Identifiant du client OIDC
OIDC_CLIENT_ID=
# Secret du client OIDC (vide pour un client public, PKCE)
OIDC_CLIENT_SECRET=
# Libellé du bouton « Se connecter avec … »
OIDC_PROVIDER_NAME=SSO
# Scopes demandés (séparés par des espaces)
OIDC_SCOPES="openid email profile"
# Permissions par défaut
OIDC_DEFAULT_PERMS=verified
# When enabled, users pay each request from a prepaid balance topped up via Mollie.
# A test_… key simulates payments (no real money); a live_… key charges for real.
MOLLIE_API_KEY=
