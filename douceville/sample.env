# Copy this file as .env, then fill and adapt the actual values.

# --- Deployment / Traefik (docker-compose) ---
JOHNCLOUD_ROOT=/path/to/root/of/paas/data
HOST=douceville.domain.tld
TZ=Etc/UTC
TRAEFIK_NETWORK=traefik-proxy
HOME_GROUP=Bureautique
HOME_NAME=douceville
HOME_ICON=
HOME_DESCRIPTION=Villes et écoles

# --- Observability ---
LOGLEVEL=INFO
BILLING_ENABLED=false

# --- Routing (app) ---
# Provider of isochrones and routes: valhalla (self-hosted service below) or
# ors (OpenRouteService, then OPENROUTESERVICE_KEY is required).
ROUTING_PROVIDER=valhalla
VALHALLA_CONCURRENCY=8
OPENROUTESERVICE_KEY=

# --- Valhalla service ---
# Valhalla service (docker compose --profile valhalla): public HTTP URL of the
# tiles on the S3-compatible storage, ending with /{tilePath}; optional basic
# auth ("user:password") of a proxy; tile memory cache (bytes); threads.
# The tiles are built and uploaded by scripts/build_valhalla_tiles.sh.
VALHALLA_TILE_URL=
VALHALLA_CACHE_BYTES=300000000
VALHALLA_THREADS=1
