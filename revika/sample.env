COMPOSE_PROJECT_NAME=revika
PANGOLIN_RESOURCE_NAME=revika_sauron
JOHNCLOUD_ROOT=/path/to/root/of/paas/data
HOST=revika.domain.tld
TZ=Etc/UTC
TRAEFIK_NETWORK=traefik-proxy
HOME_GROUP=Ressources
HOME_NAME=Revika
HOME_ICON=https://raw.githubusercontent.com/ydethe/revika/refs/heads/main/logo.png
HOME_DESCRIPTION="Decentralized, distributed, end-to-end encrypted storage system"
REPAIR_INTERVAL=1h
SEED_ADDR=/ip4/<ip address>/tcp/4001/p2p/<seed of a node>
POW_DIFFICULTY=12
PUBLIC_IP=8.8.8.8
CAPACITY=0 # Usable storage budget in bytes for load balancing (0 = use the shard filesystem's total capacity)
LOGLEVEL=info # Minimum log level: debug, info, warn, or error
STORAGE_QUOTA=0 # Per-owner storage quota in bytes (0 = unlimited)
REBALANCE_INTERVAL=1h # How often the rebalance loop runs (default 1h0m0s)
