COMPOSE_PROJECT_NAME=Webprogress
HOST=Webprogress.domain.tld
JOHNCLOUD_ROOT=/path/to/root/of/paas/data
TZ=Europe/Paris
HOME_GROUP=Ressources
HOME_NAME=Webprogress
HOME_ICON=webprogress.png
HOME_DESCRIPTION=Track a long-running task from a web UI
TRAEFIK_NETWORK=traefik-proxy
# --- OIDC provider (required to run the server) ---
# Client credentials issued by your OIDC provider (e.g. Authentik).
WEBPROGRESS_OIDC_CLIENT_ID=
WEBPROGRESS_OIDC_CLIENT_SECRET=
# Provider discovery document.
# Authentik example: https://auth.example.com/application/o/<app-slug>/.well-known/openid-configuration
WEBPROGRESS_OIDC_SERVER_METADATA_URL=
# Scopes requested at login (optional, this is the default).
WEBPROGRESS_OIDC_SCOPE=openid email profile

# --- Server (optional; defaults shown) ---
# Public base URL of this server. Used to build the "/auth" redirect URI, so
# "<base_url>/auth" must be registered as a redirect URI in the provider.
WEBPROGRESS_BASE_URL=http://127.0.0.1:8775
# Secret used to sign session cookies. Set a strong random value in production,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
WEBPROGRESS_SESSION_SECRET=LWNuldn7v_MMQuPGO0wt1Zm60lHee_N_StEh7Nh3fSA
# Path to the SQLite database holding users and tokens.
WEBPROGRESS_DB_PATH=webprogress.db
