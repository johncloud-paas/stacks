COMPOSE_PROJECT_NAME=vaultwarden
JOHNCLOUD_ROOT=/path/to/root/of/paas/data
HOST=vaultwarden.yourdomain.com
TZ=Etc/UTC
TRAEFIK_NETWORK=traefik-proxy
