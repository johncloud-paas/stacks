# Name of the user to log with
SSH_USER=sshuser
# Port to expose the SSH service on
EXPOSED_PORT=2222
# Pin the opkssh release used by setup-sshd.sh; see https://github.com/openpubkey/opkssh/releases
REMOTE_USER_EMAIL=
# URL of the OIDC issuer
OIDC_ISSUER=
# Client ID for the OIDC application
CLIENT_ID=
