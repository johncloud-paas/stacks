# Copy this file as .env, then fill and adapt the actual values
COMPOSE_PROJECT_NAME=sshd
JOHNCLOUD_ROOT=/path/to/root/of/paas/data
TRAEFIK_NETWORK=traefik-proxy
SSH_USER=sshuser
EXPOSED_PORT=2222
# Pin the opkssh release used by setup-sshd.sh; see https://github.com/openpubkey/opkssh/releases
OPKSSH_VERSION=latest # or v0.4.0
REMOTE_USER_EMAIL=
OIDC_ISSUER=
CLIENT_ID=
KEY_EXPIRATION=
